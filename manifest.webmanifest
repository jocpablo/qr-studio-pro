{
  "name": "QR Studio Pro",
  "short_name": "QR Studio",
  "description": "Generador, lector y gestor de códigos QR: diseño avanzado, verificación real, lotes, hojas de impresión y QR dinámicos.",
  "lang": "es",
  "start_url": "./qr-studio-pro.html",
